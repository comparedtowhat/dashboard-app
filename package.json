{
  "name": "link-dashboard",
  "version": "0.1.0",
  "description": "Minimal personal link dashboard for new tab page",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dashboard.ps1",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/remove-autostart.ps1",
    "migrate:vercel-kv": "node ./scripts/migrate-to-vercel-kv.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2"
  }
}
